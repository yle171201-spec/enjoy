{% extends "base.html" %}
{% block title %}账户回测{% endblock %}
{% block content %}
<div class="section-head"><div><span class="eyebrow">PORTFOLIO MTM · V2.3.8-INTEGRITY</span><h1>账户级回测</h1><p>冻结V18买点不变；RC4 A Runner已接入账户执行：A在原卖出决策前已达到≥3H且决策日5日收益≤-8%时，次日开盘兑现85%、保留15%尾仓；尾仓无固定时限，连续3日收盘低于MA30后次日开盘退出。满仓遇新A/B时尾仓先让位，再考虑C让位。</p></div></div>
<form class="toolbar" method="post">
<label>发动机<select name="engines">{% for x in ['ABC','AB','AC','BC','A','B','C'] %}<option {% if engines==x %}selected{% endif %}>{{x}}</option>{% endfor %}</select></label>
<label>执行<select name="execution"><option value="next_open" {% if execution!='close' %}selected{% endif %}>次日开盘</option><option value="close" {% if execution=='close' %}selected{% endif %}>信号收盘</option></select></label>
<label>最大持仓K<input name="k" type="number" min="1" max="20" value="{{k or 5}}"></label>
<label>A/B风险预算%<input name="ab_risk" type="number" step="0.1" value="{{ab_risk or 2.5}}"></label>
<label>C风险预算%<input name="c_risk" type="number" step="0.1" value="{{c_risk or 1.5}}"></label>
<label>单股上限%<input name="max_weight" type="number" step="1" value="{{max_weight or 20}}"></label>
<label>开始<input type="date" name="start" value="{{start or ''}}"></label><label>结束<input type="date" name="end" value="{{end or ''}}"></label>
<label>滑点bps<input name="slippage_bps" type="number" value="{{slippage_bps or 0}}"></label>
<label>佣金bps<input name="commission_bps" type="number" step="0.1" value="{{commission_bps or 0}}"></label>
<label>卖出税费bps<input name="stamp_tax_bps" type="number" step="0.1" value="{{stamp_tax_bps or 0}}"></label>
<label>MC种子数<input name="monte_carlo_seeds" type="number" min="0" max="500" value="{{monte_carlo_seeds or 0}}"></label>
<button>运行账户回测</button>
</form>
{% if result %}{% set m=result.metrics %}
<div class="metrics portfolio-metrics"><div><span>CAGR</span><b>{{'%.1f%%'|format(m.cagr*100)}}</b></div><div><span>最大回撤</span><b class="neg">{{'%.1f%%'|format(m.mdd*100)}}</b></div><div><span>终值</span><b>{{'%.2f'|format(m.terminal)}}x</b></div><div><span>CAGR/|MDD|</span><b>{{'%.2f'|format(m.calmar_like)}}</b></div><div><span>接纳交易</span><b>{{m.accepted}}</b></div><div><span>平均持仓</span><b>{{'%.2f'|format(m.avg_positions)}}</b></div><div><span>平均资金暴露</span><b>{{'%.1f%%'|format(m.avg_exposure*100)}}</b></div><div><span>实际最大持仓</span><b>{{m.max_positions_seen}}</b></div><div><span>满仓拒绝</span><b>{{m.full_rejections}}</b></div><div><span>C让位</span><b>{{m.c_replacements}}</b></div><div><span>最长水下</span><b>{{m.max_underwater_days}}T</b></div></div>
<div class="note"><b>最大回撤区间：</b>{{m.peak_date or '-'}} → {{m.trough_date or '-'}} ｜ 恢复 {{m.recovery_date or '样本末未恢复'}} ｜ 接纳 A/B/C = {{m.accepted_A}} / {{m.accepted_B}} / {{m.accepted_C}}</div>{% if result.diagnostics %}{% set d=result.diagnostics %}<div class="note"><b>数据体检：</b>输入 {{d.input_signals}} ｜ 执行对象 {{d.execution_objects}} ｜ 异常 <span class="{{'neg' if d.execution_error_count else 'ok'}}">{{d.execution_error_count}}</span> ｜ V18={{d.source_counts.get('V18',0)}} / LIVE={{d.source_counts.get('V18-LIVE',0)}} ｜ {{d.signal_start or '-'}} → {{d.signal_end or '-'}}</div>{% endif %}
{% if baseline and comparison %}{% set b=baseline.metrics %}{% set cp=comparison %}
<section>
<h2>Baseline V18 vs RC4A · 同参数同 Seed</h2>
<div class="metrics">
<div><span>Baseline CAGR*</span><b>{{'%.1f%%'|format(cp.baseline_cagr*100)}}</b></div>
<div><span>RC4A CAGR*</span><b>{{'%.1f%%'|format(cp.rc4_cagr*100)}}</b></div>
<div><span>CAGR 增量</span><b class="{{'pos' if cp.cagr_delta>=0 else 'neg'}}">{{'%+.2f'|format(cp.cagr_delta*100)}}pp</b></div>
<div><span>Baseline MDD</span><b class="neg">{{'%.1f%%'|format(cp.baseline_mdd*100)}}</b></div>
<div><span>RC4A MDD</span><b class="neg">{{'%.1f%%'|format(cp.rc4_mdd*100)}}</b></div>
<div><span>MDD变化</span><b class="{{'pos' if cp.mdd_delta>=0 else 'neg'}}">{{'%+.2f'|format(cp.mdd_delta*100)}}pp</b></div>
<div><span>Baseline终值</span><b>{{'%.3f'|format(cp.baseline_terminal)}}x</b></div>
<div><span>RC4A终值</span><b>{{'%.3f'|format(cp.rc4_terminal)}}x</b></div>
</div>
<div class="note"><b>RC4账户净增量：</b>终值 {{'%+.4f'|format(cp.terminal_delta)}}x ｜ 接纳交易 {{cp.baseline_accepted}} → {{cp.rc4_accepted}} ｜ Runner {{cp.tail_created}}。{% if cp.same_start %} *CAGR按共同观察终点 {{cp.common_end}} 对齐；Baseline末次交易后现金净值平延，不改变其MDD。{% else %} 起始日不一致，CAGR仅作提示，请优先看终值与MDD。{% endif %}</div>
</section>
{% endif %}
<div class="note"><b>RC4 Runner：</b>{{m.rc4_tail_created or 0}} 个尾仓 ｜ MA30技术退出 {{m.rc4_tail_technical_exits or 0}} ｜ 新A/B容量让位 {{m.rc4_tail_capacity_yields or 0}} ｜ 样本末仍持有 {{m.rc4_tail_open_at_end or 0}}</div>
{% if result.runner_audit %}
<section>
<h2>RC4 Runner 逐笔审计</h2>
<div class="table-wrap"><table>
<thead><tr><th>股票</th><th>A信号日</th><th>原卖出决策</th><th>原卖点次开</th><th>原卖价</th><th>成熟度</th><th>决策R5</th><th>原卖因</th><th>尾仓实际退出</th><th>尾仓退出价</th><th>退出方式</th><th>尾仓段额外收益</th></tr></thead>
<tbody>
{% for r in result.runner_audit %}
<tr>
<td><a href="/stock/{{r.code}}">{{r.code}}</a></td>
<td>{{r.signal_date}}</td>
<td>{{r.decision_date}}</td>
<td>{{r.base_exit_date or '-'}}</td>
<td>{{'%.2f'|format(r.base_exit_price) if r.base_exit_price==r.base_exit_price else '-'}}</td>
<td>{{'%.2fH'|format(r.proof_h)}}</td>
<td class="{{'neg' if r.ret5<0 else 'pos'}}">{{'%.1f%%'|format(r.ret5*100)}}</td>
<td>{{r.original_exit_reason}}</td>
<td>{{r.tail_exit_date or '样本末仍持有'}}</td>
<td>{{'%.2f'|format(r.tail_exit_price) if r.tail_exit_price==r.tail_exit_price else '-'}}</td>
<td>{{r.tail_exit_reason}}</td>
<td class="{{'pos' if r.tail_leg_return==r.tail_leg_return and r.tail_leg_return>=0 else 'neg'}}">{{'%.1f%%'|format(r.tail_leg_return*100) if r.tail_leg_return==r.tail_leg_return else '-'}}</td>
</tr>
{% endfor %}
</tbody></table></div>
<div class="note">“尾仓段额外收益” = 15% Runner 实际退出价 ÷ 原卖点次开价 − 1，只衡量尾仓这一段；完整账户净贡献以 Baseline V18 vs RC4A 的终值/CAGR差为准。</div>
</section>
{% endif %}
<div id="equity-chart" class="chart portfolio-chart"></div><script>drawEquity('equity-chart', {{chart_json|safe}});</script>
<section><h2>逐年账户表现</h2><div class="table-wrap"><table><thead><tr><th>年份</th><th>年度收益</th><th>年度MDD</th><th>年末净值</th></tr></thead><tbody>{% for y in result.yearly %}<tr><td>{{y.year}}</td><td class="{{'pos' if y.return>0 else 'neg'}}">{{'%.1f%%'|format(y.return*100)}}</td><td class="neg">{{'%.1f%%'|format(y.mdd*100)}}</td><td>{{'%.2f'|format(y.end_equity)}}x</td></tr>{% endfor %}</tbody></table></div></section>
{% if result.monte_carlo %}{% set mc=result.monte_carlo %}<section><h2>同日容量 Monte Carlo</h2><div class="metrics"><div><span>终值 P10 / P50 / P90</span><b>{{'%.2f'|format(mc.terminal_p10)}} / {{'%.2f'|format(mc.terminal_p50)}} / {{'%.2f'|format(mc.terminal_p90)}}</b></div><div><span>CAGR P50</span><b>{{'%.1f%%'|format(mc.cagr_p50*100)}}</b></div><div><span>MDD P10 / P50</span><b>{{'%.1f%%'|format(mc.mdd_p10*100)}} / {{'%.1f%%'|format(mc.mdd_p50*100)}}</b></div><div><span>接纳N P50</span><b>{{'%.0f'|format(mc.accepted_p50)}}</b></div></div></section>{% endif %}
{% endif %}
{% endblock %}
