{% extends "base.html" %}
{% block title %}执行回测{% endblock %}
{% block content %}
<div class="section-head"><div><span class="eyebrow">EXECUTION RESEARCH</span><h1>Close vs 次日开盘完整动态回测</h1><p>两种执行方式都使用A/B/C各自动态退出。NEXT_OPEN改变真实入场价、MFE与仓位；T日信号和FAIL不变。</p></div></div>
<form class="toolbar" method="post">
<label>发动机<select name="engines">{% for x in ['ABC','AB','AC','BC','A','B','C'] %}<option {% if engines==x %}selected{% endif %}>{{x}}</option>{% endfor %}</select></label>
<label>开始<input type="date" name="start" value="{{start or ''}}"></label><label>结束<input type="date" name="end" value="{{end or ''}}"></label>
<label>开盘滑点 bps<input type="number" name="slippage_bps" value="{{slippage_bps or 0}}" step="1"></label>
<label>单边佣金 bps<input type="number" name="commission_bps" value="{{commission_bps or 0}}" step="0.1"></label>
<label>卖出税费 bps<input type="number" name="stamp_tax_bps" value="{{stamp_tax_bps or 0}}" step="0.1"></label><button>运行对比</button>
</form>
{% if result %}
<div class="compare-grid">
<section class="panel"><span class="eyebrow">SIGNAL CLOSE</span><h2>信号收盘入场</h2>{% set x=result.close.summary[0] %}<div class="metric-big"><b>{{'%.1f%%'|format(x.mean*100) if x.N else '-'}}</b><span>平均动态收益</span></div><div class="mini-metrics"><span>胜率 <b>{{'%.1f%%'|format(x.win*100) if x.N else '-'}}</b></span><span>PF <b>{{'%.2f'|format(x.PF) if x.N else '-'}}</b></span><span>盈亏比 <b>{{'%.2f'|format(x.payoff) if x.N else '-'}}</b></span><span>N <b>{{x.N}}</b></span></div></section>
<section class="panel"><span class="eyebrow">NEXT OPEN</span><h2>次日开盘入场</h2>{% set x=result.next_open.summary[0] %}<div class="metric-big"><b>{{'%.1f%%'|format(x.mean*100) if x.N else '-'}}</b><span>平均动态收益</span></div><div class="mini-metrics"><span>胜率 <b>{{'%.1f%%'|format(x.win*100) if x.N else '-'}}</b></span><span>PF <b>{{'%.2f'|format(x.PF) if x.N else '-'}}</b></span><span>盈亏比 <b>{{'%.2f'|format(x.payoff) if x.N else '-'}}</b></span><span>N <b>{{x.N}}</b></span></div></section>
</div>

<section><h2>分发动机比较</h2><div class="table-wrap"><table><thead><tr><th>范围</th><th>模式</th><th>N</th><th>平均</th><th>中位</th><th>胜率</th><th>PF</th><th>盈亏比</th><th>Q10</th><th>最差</th></tr></thead><tbody>{% for mode,data in [('Close',result.close),('Next Open',result.next_open)] %}{% for x in data.summary %}<tr><td>{{x.scope}}</td><td>{{mode}}</td><td>{{x.N}}</td><td>{{'%.1f%%'|format(x.mean*100) if x.N else '-'}}</td><td>{{'%.1f%%'|format(x.median*100) if x.N else '-'}}</td><td>{{'%.1f%%'|format(x.win*100) if x.N else '-'}}</td><td>{{'%.2f'|format(x.PF) if x.N else '-'}}</td><td>{{'%.2f'|format(x.payoff) if x.N else '-'}}</td><td>{{'%.1f%%'|format(x.q10*100) if x.N else '-'}}</td><td>{{'%.1f%%'|format(x.worst*100) if x.N else '-'}}</td></tr>{% endfor %}{% endfor %}</tbody></table></div></section>

<section><h2>隔夜缺口分层（Next Open）</h2><div class="table-wrap"><table><thead><tr><th>缺口</th><th>N</th><th>平均</th><th>胜率</th><th>PF</th><th>盈亏比</th><th>MFE均值</th><th>MAE均值</th></tr></thead><tbody>{% for x in result.gap_buckets %}<tr><td>{{x.bucket}}</td><td>{{x.N}}</td><td>{{'%.1f%%'|format(x.mean*100)}}</td><td>{{'%.1f%%'|format(x.win*100)}}</td><td>{{'%.2f'|format(x.PF)}}</td><td>{{'%.2f'|format(x.payoff)}}</td><td>{{'%.1f%%'|format(x.mfe_mean*100)}}</td><td>{{'%.1f%%'|format(x.mae_mean*100)}}</td></tr>{% endfor %}</tbody></table></div><p class="muted">缺口分层只用于诊断，不自动生成“高开X%不买”规则。</p></section>

{% if result.next_open.skip_counts %}<section class="note"><b>Next Open跳过：</b>{{result.next_open.skip_counts}}</section>{% endif %}
{% endif %}
{% endblock %}
